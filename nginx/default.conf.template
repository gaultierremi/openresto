map $uri $openresto_log_path {
    ~*^/(?:api/)?onboarding/invitations?/ /onboarding/invitation/[masque];
    ~*^/(?:api/bookings/ref|booking-confirmation)/ /bookings/[masque];
    ~*^/(?:api/)?menus?/[rt]/ /menu/[masque];
    default $uri;
}
log_format openresto_privacy '$remote_addr [$time_local] "$request_method $openresto_log_path $server_protocol" $status $body_bytes_sent';

server {
    listen ${PORT};
    server_tokens off;

    resolver ${RESOLVER} valid=10s ipv6=off;
    resolver_timeout 5s;

    access_log /dev/stdout openresto_privacy;
    error_log /dev/stderr crit;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1000;
    gzip_proxied any;
    gzip_types text/plain text/css application/json application/javascript text/xml
               application/xml image/svg+xml font/woff font/woff2
               application/font-woff application/font-woff2 font/ttf application/x-font-ttf;

    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_cache_bypass $http_upgrade;
    proxy_redirect off;

    proxy_connect_timeout 60s;
    proxy_send_timeout    120s;
    proxy_read_timeout    120s;
    proxy_buffering       off;

    # Large enough for a 10 MB PDF menu upload plus multipart framing
    client_max_body_size 12M;

    # Block dotfiles
    location ~ /\.(?!well-known).* {
        deny all;
        access_log off;
        log_not_found off;
    }

    location ~* (?:^|/)\.(?:env|git|htaccess|config|sql|log)$ {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Universal Links / App Links verification for a self-hoster's native guest app
    # (https://docs.openres.to/guides/native-app/). Served from a directory mounted into this container so the
    # prebuilt frontend image never has to change. Apple's file has no extension and must
    # come back as application/json, hence the default_type; ^~ keeps the dotfile deny
    # regex above from being consulted for this prefix.
    location ^~ /.well-known/ {
        root /usr/share/nginx/html;
        default_type application/json;
        add_header Cache-Control "public, max-age=3600" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Media — static file serving from shared volume
    location /media/ {
        alias /usr/share/nginx/html/media/;
        sendfile on;
        tcp_nopush on;
        expires 30d;
        add_header Cache-Control "public, no-transform" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Health Check
    location /health {
        access_log off;
        default_type text/plain;
        return 200 "OK";
    }

    # OpenAPI spec — only reachable when backend runs with ASPNETCORE_ENVIRONMENT=Development
    # Used by ZAP in CI to discover all API endpoints; not present in prod nginx config.
    location /openapi/ {
        set $backend_host ${BACKEND_HOST};
        proxy_pass http://$backend_host:${BACKEND_PORT};
    }

    # Expo static assets — content-hashed filenames, safe to cache indefinitely
    location /_expo/static/ {
        include /etc/nginx/conf.d/security-headers.conf;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable" always;

        set $frontend_host ${FRONTEND_HOST};
        proxy_pass http://$frontend_host:${FRONTEND_PORT};
    }

    # API — Proxy to Backend
    location /api/ {
        include /etc/nginx/conf.d/security-headers.conf;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store, max-age=0" always;

        # Variable must be just the host for runtime DNS resolution to work
        set $backend_host ${BACKEND_HOST};
        proxy_pass http://$backend_host:${BACKEND_PORT};

        error_page 404 500 502 503 504 = @api_error;
    }

    location @api_error {
        default_type application/json;
        return 500 '{"error": "Internal Server Error", "message": "Service unavailable"}';
    }

    # Restaurant websites — server-rendered HTML, so the backend answers, not the Expo app.
    # Cache-Control is left as the backend set it (one minute) so an unpublish shows up fast.
    location ~ ^/(?:r/[a-z0-9-]+(?:/reserver)?|sitemap\.xml|robots\.txt|decouvrir|inscription(?:/envoyee)?|legal(?:/[a-z-]+)?)$ {
        include /etc/nginx/conf.d/security-headers.conf;

        set $backend_host ${BACKEND_HOST};
        proxy_pass http://$backend_host:${BACKEND_PORT};
    }

    # Frontend — Proxy to Static Server
    location = / {
        include /etc/nginx/conf.d/security-headers.conf;
        set $backend_host ${BACKEND_HOST};
        proxy_pass http://$backend_host:${BACKEND_PORT};
        proxy_intercept_errors on;
        error_page 404 = @legacy_home;
    }

    location ~ ^/(?:locations(?:/[0-9]+)?|lookup|booking-confirmation/[^/]+|menu/[rt]/[^/]+)$ {
        include /etc/nginx/conf.d/security-headers.conf;
        set $backend_host ${BACKEND_HOST};
        proxy_pass http://$backend_host:${BACKEND_PORT};
        proxy_intercept_errors on;
        error_page 404 = @public_guest_fallback;
    }

    location @public_guest_fallback {
        include /etc/nginx/conf.d/security-headers.conf;
        set $guest_host ${BACKEND_HOST};
        set $guest_port ${BACKEND_PORT};
        if ($upstream_http_x_openresto_legacy = "true") {
            set $guest_host ${FRONTEND_HOST};
            set $guest_port ${FRONTEND_PORT};
        }
        proxy_pass http://$guest_host:$guest_port;
    }

    location @legacy_home {
        include /etc/nginx/conf.d/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        set $frontend_host ${FRONTEND_HOST};
        proxy_pass http://$frontend_host:${FRONTEND_PORT};
    }

    location /onboarding {
        include /etc/nginx/conf.d/security-headers.conf;
        add_header Cache-Control "no-store" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Referrer-Policy "no-referrer" always;
        set $frontend_host ${FRONTEND_HOST};
        proxy_pass http://$frontend_host:${FRONTEND_PORT};
    }

    location / {
        include /etc/nginx/conf.d/security-headers.conf;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-cache" always;

        set $frontend_host ${FRONTEND_HOST};
        proxy_pass http://$frontend_host:${FRONTEND_PORT};
    }
}
