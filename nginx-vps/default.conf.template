# Rate limiting zones
map $uri $openresto_log_path {
    ~*^/(?:api/)?onboarding/invitations?/ /onboarding/invitation/[masque];
    ~*^/(?:api/bookings/ref|booking-confirmation)/ /bookings/[masque];
    ~*^/api/holds/ /api/holds/[masque];
    ~*^/(?:api/)?menus?/[rt]/ /menu/[masque];
    default $uri;
}
log_format openresto_privacy '$remote_addr [$time_local] "$request_method $openresto_log_path $server_protocol" $status $body_bytes_sent';

limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=general:10m rate=30r/s;

server {
    listen 80;
    server_name ${DOMAIN_NAME};
    server_tokens off;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ${DOMAIN_NAME};
    server_tokens off;

    ssl_certificate /etc/nginx/ssl/server.crt;
    ssl_certificate_key /etc/nginx/ssl/server.key;

    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    access_log /dev/stdout openresto_privacy;
    error_log /dev/stderr crit;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1000;
    gzip_proxied any;
    gzip_types text/plain text/css application/json application/javascript text/xml
               application/xml image/svg+xml font/woff font/woff2
               application/font-woff application/font-woff2 font/ttf application/x-font-ttf;

    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_cache_bypass $http_upgrade;
    proxy_redirect off;

    # Large enough for a 10 MB PDF menu upload plus multipart framing
    client_max_body_size 12M;

    # Block dotfiles
    location ~ /\.(?!well-known).* {
        deny all;
        access_log off;
        log_not_found off;
    }

    location /api/ {
        limit_req zone=api burst=20 nodelay;
        include /etc/nginx/conf.d/security-headers.conf;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store, max-age=0" always;
        proxy_pass http://backend:8080;
        error_page 404 500 502 503 504 = @api_error;
    }

    location @api_error {
        default_type application/json;
        return 500 '{"error": "Internal Server Error", "message": "Service unavailable"}';
    }

    # Expo static assets — content-hashed filenames, safe to cache indefinitely
    location /_expo/static/ {
        limit_req zone=general burst=50 nodelay;
        include /etc/nginx/conf.d/security-headers.conf;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        proxy_pass http://frontend:8081;
    }

    # Restaurant websites — server-rendered HTML from the backend; its own one-minute Cache-Control is kept.
    location ~ ^/(?:r/[a-z0-9-]+(?:/reserver)?|sitemap\.xml|robots\.txt|decouvrir|inscription(?:/envoyee)?|legal(?:/[a-z-]+)?)$ {
        limit_req zone=general burst=50 nodelay;
        include /etc/nginx/conf.d/security-headers.conf;
        proxy_pass http://backend:8080;
    }

    location = / {
        include /etc/nginx/conf.d/security-headers.conf;
        proxy_pass http://backend:8080;
        proxy_intercept_errors on;
        error_page 404 = @legacy_home;
    }

    location ~ ^/(?:locations(?:/[0-9]+)?|lookup|booking-confirmation/[^/]+|menu/[rt]/[^/]+)$ {
        include /etc/nginx/conf.d/security-headers.conf;
        proxy_pass http://backend:8080;
        proxy_intercept_errors on;
        error_page 404 = @public_guest_fallback;
    }

    location @public_guest_fallback {
        include /etc/nginx/conf.d/security-headers.conf;
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $guest_host backend;
        set $guest_port 8080;
        if ($upstream_http_x_openresto_legacy = "true") {
            set $guest_host frontend;
            set $guest_port 8081;
        }
        proxy_pass http://$guest_host:$guest_port;
    }

    location @legacy_home {
        include /etc/nginx/conf.d/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        proxy_pass http://frontend:8081;
    }

    location /onboarding {
        include /etc/nginx/conf.d/security-headers.conf;
        add_header Cache-Control "no-store" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Referrer-Policy "no-referrer" always;
        proxy_pass http://frontend:8081;
    }

    location / {
        limit_req zone=general burst=50 nodelay;
        include /etc/nginx/conf.d/security-headers.conf;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-cache" always;
        proxy_pass http://frontend:8081;
    }

    # Media — static file serving from shared volume
    location /media/ {
        alias /usr/share/nginx/html/media/;
        sendfile on;
        tcp_nopush on;
        expires 30d;
        add_header Cache-Control "public, no-transform" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location /health {
        access_log off;
        default_type text/plain;
        return 200 "OK";
    }
}
