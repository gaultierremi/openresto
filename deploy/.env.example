# OpenResto production — copy to .env (chmod 600) and fill in. Never commit the .env.

# --- Public address -------------------------------------------------------------------------
# Host name pointing at this VM (DNS A record). Caddy gets the HTTPS certificate for it.
DOMAIN=reservations.example.be
# Let's Encrypt writes here before a certificate expires.
ACME_EMAIL=ops@example.be

# --- Images ---------------------------------------------------------------------------------
OPENRESTO_REGISTRY=ghcr.io/karanshukla
# Pin an exact release; never "latest" in production.
OPENRESTO_VERSION=2.4.1

# --- Data on the host -----------------------------------------------------------------------
# <DATA_DIR>/db holds openresto.db and the Data Protection keys, <DATA_DIR>/media the uploads.
DATA_DIR=/srv/openresto

# --- Backend (required) ---------------------------------------------------------------------
# openssl rand -base64 48
JWT_KEY=
# First-boot Owner account; the password is only read while the database has no account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Default UI language of the public site: fr, en, es or de.
OPENRESTO_DEFAULT_LOCALE=fr

# --- Booking confirmation emails (optional) --------------------------------------------------
# Used to fill the admin's Settings > Email page on the FIRST boot only; after that the admin
# page is the source of truth and these are ignored. Leave SMTP_HOST empty to configure it in
# the admin instead. Port 587 = STARTTLS; any other port = implicit TLS (465) when SSL is true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=OpenResto
SMTP_ENABLE_SSL=true
SMTP_SEND_CONFIRMATIONS=true

# --- Push notifications (optional): npx web-push generate-vapid-keys -------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.be

# --- Backups (read by backup/backup.sh) -----------------------------------------------------
BACKUP_DIR=/srv/openresto-backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
# Off-site copy through rclone (https://rclone.org): "<remote>:<bucket-or-path>". Empty = local only.
BACKUP_REMOTE=
# Days an off-site copy is kept (4 weeks + a margin).
BACKUP_REMOTE_RETENTION_DAYS=35
# Optional dead-man's-switch URL (healthchecks.io style) pinged after each successful backup.
BACKUP_PING_URL=
