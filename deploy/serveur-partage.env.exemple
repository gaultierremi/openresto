# Configuration d'OpenResto sur un serveur partagé. Ce fichier est un MODÈLE : ./deploy/installer.sh
# crée le vrai (deploy/serveur-partage.env), avec des mots de passe fabriqués au hasard.
# Le vrai fichier reste SUR LE SERVEUR : jamais dans le dépôt, jamais envoyé par message ni par e-mail.
# Règle : lettres, chiffres, tirets seulement dans les mots de passe (pas de $ # espace ni guillemet).

# --- Où le site s'ouvre ---------------------------------------------------------------------------------
# Port sur le serveur. Apprenti occupe déjà le 8080 : OpenResto prend le 8081.
OPENRESTO_PORT=8081
# 0.0.0.0 = joignable depuis Internet (avec mot de passe). 127.0.0.1 = seulement depuis le serveur lui-même,
# à choisir quand le Caddy du serveur sert un nom de domaine devant OpenResto.
OPENRESTO_ECOUTE=0.0.0.0
# L'adresse exacte que les gens tapent dans leur navigateur (sans « / » final).
OPENRESTO_URL_PUBLIQUE=http://ADRESSE-IP:8081

# --- Mot de passe du site (tant qu'il n'y a pas de nom de domaine) ---------------------------------------
# 1 = le navigateur demande l'identifiant et le mot de passe ci-dessous avant d'afficher quoi que ce soit.
# 0 = site ouvert à tous : seulement derrière un nom de domaine en HTTPS, jamais sur une adresse IP.
OPENRESTO_ACCES_PROTEGE=1
OPENRESTO_UTILISATEUR=essai
OPENRESTO_MOT_DE_PASSE=

# --- Mode ----------------------------------------------------------------------------------------------
# Development = essai sur une adresse http:// (le seul où la connexion de l'administration fonctionne en HTTP).
#   Données FICTIVES seulement.
# Production = site derrière un nom de domaine en HTTPS (les cookies de connexion l'exigent).
OPENRESTO_ENVIRONNEMENT=Development
# Langue du site public : fr, en, es ou de.
OPENRESTO_LANGUE=fr

# --- Compte administrateur (créé au premier démarrage seulement) ------------------------------------------
ADMIN_EMAIL=admin@openresto.local
ADMIN_PASSWORD=
# Clé qui signe les connexions. Fabriquée par l'installateur ; la changer déconnecte tout le monde.
JWT_KEY=

# --- Mails de confirmation (facultatif) --------------------------------------------------------------------
# Remplissent la page Paramètres > Email au PREMIER démarrage seulement. Laissez SMTP_HOST vide pour la régler dans l'admin.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=OpenResto
SMTP_ENABLE_SSL=true
SMTP_SEND_CONFIRMATIONS=true

# --- Sauvegardes -----------------------------------------------------------------------------------------
# Dossier des sauvegardes (lisible par vous seul). Doit être joignable en écriture sans sudo.
BACKUP_DIR=./deploy/sauvegardes
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
