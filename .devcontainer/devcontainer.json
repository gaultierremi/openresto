{
  "name": "OpenResto — démo",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [5062],
  "portsAttributes": {
    "5062": {
      "label": "OpenResto",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash .devcontainer/demo.sh setup",
  "postStartCommand": "bash .devcontainer/demo.sh start"
}
